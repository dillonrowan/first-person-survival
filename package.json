{
    "name": "first-person-survival",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tools/world-export",
        "download-cache": "node scripts/download-cache.mjs",
        "fetch-wiki-attacks": "tsx tools/world-export/fetch-wiki-attacks.ts",
        "fetch-wiki-items": "tsx tools/world-export/fetch-wiki-items.ts",
        "export-cache-weapons": "tsx tools/world-export/export-cache-weapons.ts",
        "export-items": "node --max-old-space-size=8192 --import tsx tools/world-export/export-items.ts",
        "export-world": "node --max-old-space-size=16384 --import tsx tools/world-export/export-world.ts"
    },
    "dependencies": {
        "three": "^0.187.0"
    },
    "devDependencies": {
        "@argos-ci/playwright": "^7.8.0",
        "@playwright/test": "^1.57.0",
        "@types/node": "^26.6.6",
        "@types/three": "^0.187.0",
        "bzip2": "^0.1.1",
        "fflate": "^0.8.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
